DATABASE_URL="file:./data/dev.db"

PORT=4000

# Fixed single admin user (no user registration/multi-user support)
ADMIN_USERNAME=admin
# bcrypt hash of the admin password — generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

JWT_SECRET=

# Set to "true" only if this API is served over HTTPS (e.g. behind a TLS-terminating
# reverse proxy). Leave "false" for plain-HTTP deployments — otherwise the browser
# will silently refuse to send the auth cookie back.
COOKIE_SECURE=false

# Origin allowed to call the API with credentials. Only needed when running
# frontend and backend on different origins (e.g. local dev without Docker,
# frontend on :5173). Defaults to http://localhost:5173 if unset.
CORS_ORIGIN=http://localhost:5173
